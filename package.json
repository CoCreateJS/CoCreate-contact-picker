{
  "name": "@cocreate/contact-picker",
  "version": "1.0.0",
  "description": "Helpers for the browser Contact Picker API.",
  "keywords": [
    "contact-picker",
    "contacts",
    "browser-api",
    "low-code",
    "html5-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Helpers for the browser Contact Picker API.",
      "source": "src/index.js",
      "declarative": {
        "actions": [
          {
            "name": "getContacts"
          }
        ]
      },
      "api": {
        "exports": [
          "getContacts",
          "init",
          "isSupported",
          "setContacts"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-contact-picker.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-contact-picker/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/contact-picker",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.27.0",
    "@cocreate/render": "^1.51.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/actions@1.27.0": true,
    "@cocreate/render@1.46.1": true,
    "@cocreate/webpack@1.9.0": true
  }
}
